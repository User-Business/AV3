# Porta e interface HTTP (configuráveis por variável de ambiente, como pede a atividade)
PORT=3333
HOST=0.0.0.0

# PostgreSQL (o docker-compose.yml sobe exatamente este banco)
DATABASE_URL="postgresql://greencode:greencode@localhost:5432/greencode?schema=public"

# Segredo do JWT: no mínimo 32 caracteres. Gere um com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-este-segredo-por-um-valor-aleatorio-de-48-bytes"
# Mesma política do CLI: sessão de 30 minutos
JWT_EXPIRES_IN=30m

# Origem do front-end SPA (separe várias por vírgula)
CORS_ORIGIN=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# ---------------------------------------------------------------- Atividade 3
# Fila de relatórios: com REDIS_URL usa BullMQ; sem ele, fila em memória
# (o Redis não tem versão oficial para Windows). O docker-compose sobe um Redis.
# REDIS_URL=redis://localhost:6379
# Processa a fila dentro do servidor HTTP (false = use workers: npm run start:worker)
WORKER_EMBUTIDO=true
FILA_CONCORRENCIA=2

# Arquivos dos relatórios assíncronos e por quantas horas ficam disponíveis
DIRETORIO_RELATORIOS=./armazenamento/relatorios
RELATORIO_VALIDADE_HORAS=72

# Segredo do HMAC-SHA256 que assina os webhooks enviados aos parceiros
WEBHOOK_SECRET="troque-este-segredo-de-webhook"

# Rotinas agendadas (sintaxe cron; vazio desativa) e fuso horário
ANALISES_CRON=0 2 * * *
LIMPEZA_CRON=30 3 * * *
TZ_AGENDADOR=America/Sao_Paulo
