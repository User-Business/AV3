{
  "name": "greencode",
  "version": "3.0.0",
  "description": "greencode - plataforma de logística reversa com camada analítica e API pública (Node.js + TypeScript + Fastify + Prisma ORM)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "setup": "prisma generate && prisma migrate deploy && prisma db seed",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "worker": "tsx watch src/worker.ts",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "test": "node --import tsx --test --test-concurrency=1 \"tests/**/*.test.ts\"",
    "test:unit": "node --import tsx --test \"tests/unit/*.test.ts\""
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/jwt": "10.2.5",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@fastify/swagger-ui": "6.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "bullmq": "5.81.5",
    "dotenv": "18.0.8",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "ioredis": "5.11.1",
    "node-cron": "4.6.0",
    "pg": "8.23.1",
    "pino": "9.14.0",
    "simple-statistics": "7.12.1",
    "typebox": "1.4.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "msgpackr-extract": false
  }
}
